# Что НЕ уходит в git.
#
# Правило простое: в репозитории лежит только то, из чего всё остальное
# собирается. Виртуальное окружение, сборки и артефакты воспроизводятся
# командой, а весят сотни мегабайт -- в истории им делать нечего.

# --- окружение и сборка (сотни МБ) ---
.venv/
venv/
env/
build/
dist/
*.spec
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- то, что программа создаёт сама ---
*.bak
*.log
_test/*.PcbLib
_test/*.SchLib
_test/*.IntLib
_test/*.LibPkg

# --- рабочие файлы Altium рядом с библиотеками ---
History/
__Previews__/
Project Outputs*/
Project Logs*/
*.PcbDoc.bak*
*.SchDoc.bak*
*.~*

# --- личное окружение редактора и системы ---
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# --- ВАЖНО: это НУЖНО в репозитории, не добавляйте сюда ---
# gostlib/templates/empty.PcbLib -- пустая библиотека, сохранённая самим
#   Altium; без неё не работает запасной путь прямой записи .PcbLib и
#   падает одна проверка самопроверки. 100 КБ, двоичный, но обязательный.
# gostlib/altium/GostLibBuilder.pas и .PrjScr -- исходник скрипта.
# installer/gostlib.iss -- сценарий установщика.
